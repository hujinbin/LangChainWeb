{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "axios": "^1.6.5",
    "dayjs": "^1.11.10",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-icons": "^5.0.1",
    "react-router-dom": "^6.14.1",
    "react-scripts": "5.0.1",
    "reactflow": "^11.11.0",
    "uuid": "^9.0.1",
    "zustand": "^4.5.0"
  },
  "scripts": {
    "start": "tsx --tsconfig tsconfig.tools.json scripts/build.ts --prepare && react-scripts start",
    "dev": "npm start",
    "build": "npm run typecheck && tsx --tsconfig tsconfig.tools.json scripts/build.ts",
    "test": "react-scripts test",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.tools.json",
    "check:seo": "tsx --tsconfig tsconfig.tools.json scripts/check-seo.ts",
    "check:proxy": "tsx --tsconfig tsconfig.tools.json scripts/check-proxy.ts",
    "eject": "react-scripts eject"
  },
  "jest": {
    "moduleNameMapper": {
      "^axios$": "<rootDir>/node_modules/axios/dist/browser/axios.cjs"
    }
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/jest": "^27.5.2",
    "@types/node": "16.18.126",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/uuid": "^9.0.8",
    "esbuild": "0.28.2",
    "express": "^4.22.3",
    "http-proxy-middleware": "^2.0.12",
    "markdown-it": "^14.3.3",
    "tsx": "^4.23.15",
    "typescript": "5.1.6"
  },
  "overrides": {
    "react-scripts": {
      "typescript": "5.1.6"
    }
  }
}
