# 复制为 .env 后修改；docker compose 会自动读取。
# 浏览器访问的 API 根地址，留空表示同源 /api。
PUBLIC_API_BASE_URL=
# Nginx 反代目标：官方后端或自有后端。
API_UPSTREAM=https://jue.leheavengame.com
# 官方网关的 /partner/api/ 对应代理商服务，/partner/ 页面随前端发布。自建时填写独立服务源站。
PARTNER_UPSTREAM=https://jue.leheavengame.com
# 由外层反代终止 HTTPS 时设为 https。
PUBLIC_SCHEME=
WEB_BIND=0.0.0.0
WEB_PORT=80
# 固定站点标识；留空时由后端按域名识别。
SITE_ID=
PARTNER_PATH=/partner/
# 首屏品牌兜底，最终以后端站点配置为准。
BRAND_NAME=
LOGO_URL=
FAVICON_URL=
DEFAULT_THEME=auto
HELP_URL=
QQ_GROUP=
