# 复制为 .env 后修改；docker compose 会自动读取。
# 浏览器访问的 API 根地址，留空表示同源 /api。
PUBLIC_API_BASE_URL=
# Nginx 反代目标：官方后端或自有后端。
API_UPSTREAM=https://jue.leheavengame.com
# 站点后台反代目标，默认与 API 相同。
ADMIN_UPSTREAM=https://jue.leheavengame.com
# 固定站点标识；留空时由后端按域名识别。
SITE_ID=
ADMIN_PATH=/admin
# 首屏品牌兜底，最终以后端站点配置为准。
BRAND_NAME=
LOGO_URL=
FAVICON_URL=
DEFAULT_THEME=auto
HELP_URL=
QQ_GROUP=
